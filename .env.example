GEMINI_API_KEY=your_api_key_here
SMARTDIGEST_API_URL=http://127.0.0.1:8000
SMARTDIGEST_RATE_LIMIT_PER_MINUTE=30
SMARTDIGEST_JOB_WORKERS=2
SMARTDIGEST_JOB_TTL_HOURS=24
SMARTDIGEST_JOB_QUEUE_LIMIT=50
SMARTDIGEST_ENV=development
SMARTDIGEST_REDIS_URL=redis://127.0.0.1:6379/0
SMARTDIGEST_TRUST_PROXY_HEADERS=false
SMARTDIGEST_AUTH_IP_LIMIT_PER_5_MINUTES=30
SMARTDIGEST_GLOBAL_IP_LIMIT_PER_MINUTE=120
SMARTDIGEST_REQUIRE_EMAIL_VERIFICATION=false
SMARTDIGEST_PUBLIC_APP_URL=http://127.0.0.1:8501
SMARTDIGEST_SMTP_HOST=
SMARTDIGEST_SMTP_PORT=587
SMARTDIGEST_SMTP_USERNAME=
SMARTDIGEST_SMTP_PASSWORD=
SMARTDIGEST_SMTP_FROM=
SMARTDIGEST_SMTP_USE_TLS=true
SMARTDIGEST_ADMIN_EMAILS=
# Production HTTPS alan adı (docker compose --profile production up):
SMARTDIGEST_DOMAIN=
# Üretimde kalıcı ve gizli bir Fernet anahtarı kullanın:
# SMARTDIGEST_FERNET_KEY=
# Üretimde kalıcı ve gizli bir JWT imzalama anahtarı kullanın (yoksa otomatik üretilir):
# SMARTDIGEST_JWT_SECRET=
# Anahtar env değişkenleri verilmezse anahtar dosyaları kalıcı veri dizininde tutulur.
